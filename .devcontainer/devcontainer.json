{
  "name": "OFSD Frontend",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "anthropic.claude-code",
        "ritwickdey.liveserver"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true
      }
    }
  },
  "forwardPorts": [3000, 5173, 4455],
  "portsAttributes": {
    "3000": { "label": "Frontend (Vite dev)", "onAutoForward": "openBrowser" },
    "5173": { "label": "Vite preview" },
    "4455": { "label": "Backend API (Flask)" }
  },
  "postCreateCommand": "npm install && echo '\\n\\n=== OFSD setup complete ===\\nNext: read CLAUDE.md, then run: claude\\n'",
  "remoteUser": "node"
}
